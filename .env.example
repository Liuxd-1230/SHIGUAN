# 本地环境配置模板（复制为 .env 后填写；.env 已被忽略，不进仓库）
# 仅含本地路径，不要写入真实 API Key / 密钥

# CK3 游戏安装目录（GameDataResolver 从中读取真实 DLC 列表）
# SHIGUAN_CK3_GAME_DIR=C:\Program Files (x86)\Steam\steamapps\common\Crusader Kings III

# （可选）CK3 存档目录；不设置则自动探测 Documents/Paradox Interactive/.../save games
# SHIGUAN_CK3_SAVES_DIR=C:\Users\YourName\Documents\Paradox Interactive\Crusader Kings III\save games

# 目录监听轮询间隔（秒）
# SHIGUAN_WATCH_INTERVAL=2.0

# ---- Phase 3A：LLM Provider（传记提纲生成）----
# 默认配置即本地 llama.cpp / LM Studio / Ollama 兼容接口，无需修改即可用。
# 远程地址（非 localhost/127.0.0.1）必须显式 LLM_ALLOW_REMOTE=true 才会放行。
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=Qwen2.5-7B-Instruct
# 仅本地使用；不要提交真实 Key，不要写入日志
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=120
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096
# 远程模型被默认禁用；如确需调用远程服务，请显式开启并确认数据发送范围
# LLM_ALLOW_REMOTE=false
