# =============================================================================
# 史官 SHIGUAN —— 环境变量示例
# -----------------------------------------------------------------------------
# 用法：复制本文件为 `.env` 后再填写。`.env` 已被 .gitignore 忽略，
#       绝对不要提交真实密钥或真实存档。
# 所有密钥类字段都留空或不写，程序默认优先使用本地模型与本地隐私。
# =============================================================================

# ---- 大模型服务（兼容 OpenAI /v1/chat/completions 或 /v1/responses） ----
# 本地模型优先：llama.cpp server / LM Studio / Ollama 的兼容接口。
# 例：http://localhost:1234/v1   或   http://localhost:11434/v1
LLM_API_BASE_URL=http://localhost:1234/v1

# 本地模型通常不需要 key，留空即可；使用 OpenAI 等远程服务时再填写。
# 警告：不要把真实 key 写入本文件或提交到 Git。
LLM_API_KEY=

# 模型名称（本地模型可任意命名，如 "local-model"）。
LLM_MODEL=local-model

# 生成参数。
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# 上下文长度提示：用于档案压缩时控制喂给模型的数据量。
LLM_CONTEXT_HINT=8000

# 是否允许把（压缩后的结构化人物档案）发送到远程模型服务。
# 默认 false，仅当 API Base URL 指向本机/局域网时才建议保持 false。
# 设为 true 前必须理解：人物档案中的部分数据将发送至所配置的模型服务。
LLM_ALLOW_REMOTE=false

# ---- 存档解析外部组件 ----
# Rakaly CLI 二进制路径（用于融化 binary / ironman 存档为明文）。
# 留空表示自动从 PATH 探测；若不存在，解析阶段会显式报错并给出安装提示。
# 文档见 docs/save-format-notes.md。
RAKALY_BINARY_PATH=rakaly

# 铁人存档解码需要的令牌表文件（按 PDS 要求不能随库分发，须由用户本地提供）。
# 留空表示未提供；此时 ironman 存档将无法本地解码，解析阶段会明确提示。
RAKALY_IRONMAN_TOKENS_PATH=

# ---- 应用与存储 ----
# SQLite 数据库路径（保存项目、人物索引、生成记录与用户设置）。
DATABASE_URL=sqlite:///./data/shiguan.db

# 上传与临时解压目录（真实存档不进版本库）。
SAVE_UPLOAD_DIR=./data/uploads

# 日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO

# 运行环境：development / production。
APP_ENV=development
